{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "esp-idf": {
      "type": "local",
      "command": ["eim", "run", "idf.py mcp-server"],
      "enabled": true
    },
    "espressif-documentation": {
      "type": "remote",
      "url": "https://mcp.espressif.com/docs",
      "enabled": true
    },
    "esp-component-registry": {
      "type": "remote",
      "url": "https://components.espressif.com/mcp",
      "enabled": true
    },
    "rainmaker": {
      "type": "remote",
      "url": "https://mcp.rainmaker.espressif.com/api/mcp",
      "enabled": false
    },
    "esp-vision": {
      "type": "remote",
      "url": "https://mcp.vision.espressif.com",
      "enabled": false
    },
    "espressif-engineering": {
      "type": "remote",
      "url": "https://ts-mcp.espressif.com/mcp",
      "enabled": true
    }
  },

  "agent": {
    "afk": {
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "mode": "primary",
      "description": "Orchestrates AFK development work. Reads issues, dispatches implementer and reviewer subagents, updates tracker state.",
      "permission": {
        "read": { 
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "edit": { "*": "allow" },
        "bash": {
          "*": "allow",
          "git push *": "deny",
          "git push --force *": "deny",
          "git branch -D *": "deny",
          "*cat *.env*": "deny",
          "*grep *.env*": "deny",
          "*head *.env*": "deny",
          "*tail *.env*": "deny"
        },
        "task": "allow",
        "webfetch": "ask",
        "websearch": "ask"
      }
    },
    "implementer": {
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "mode": "subagent",
      "description": "Writes production code and tests",
      "permission": {
        "read": { 
          "*": "allow",
          ".env": "deny",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "edit": { "*": "allow" },
        "bash": {
          "*": "allow",
          "git push *": "deny",
          "git push --force *": "deny",
          "git branch -D *": "deny",
          "*cat *.env*": "deny",
          "*grep *.env*": "deny",
          "*head *.env*": "deny",
          "*tail *.env*": "deny"
        },
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "reviewer": {
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "mode": "subagent",
      "description": "Reads code and diffs to review spec compliance and quality. Writes review outcomes.",
      "permission": {
        "read": { 
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "edit": {
          ".scratch/**": "allow",
          "*": "deny"
        },
        "bash": {
          "*": "allow",
          "git push *": "deny",
          "git push --force *": "deny",
          "git branch -D *": "deny",
          "git add *": "deny",
          "git commit *": "deny",
          "*cat *.env*": "deny",
          "*grep *.env*": "deny",
          "*head *.env*": "deny",
          "*tail *.env*": "deny"
        },
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}

