# Release overrides — layered on top of sdkconfig.defaults by the "release" preset

CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# Disable debug-only features
# Use print+reboot panic behaviour (faster than halt)
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Core dump off (saves flash)
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y

# Heap monitoring off
CONFIG_HEAP_POISONING_DISABLED=y
CONFIG_HEAP_TRACING_OFF=y

# Debug-only features off
CONFIG_ESP_DEBUG_TOUCH_OVERLAY=n

# LVGL perf/memory monitor off (debug overlay only)
CONFIG_LV_USE_SYSMON=n