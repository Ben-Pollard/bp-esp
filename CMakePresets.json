{
    "version": 3,
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug build — GDB Stub, core dump, heap monitoring, no optimization",
            "binaryDir": "build/debug",
            "cacheVariables": {
                "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;components/gen_bmgr_codes/board_manager.defaults"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Release build — warn logs, size-optimized, assertions off",
            "binaryDir": "build/release",
            "cacheVariables": {
                "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.defaults.release;components/gen_bmgr_codes/board_manager.defaults"
            }
        }
    ]
}