# Common app defaults — always apply regardless of preset
# Board-specific config is in components/gen_bmgr_codes/board_manager.defaults (auto-generated)

# Logging
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y

# Compilation
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y

# Debugging
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# GDB Stub — break into debugger over UART (Ctrl+C in monitor)
CONFIG_ESP_SYSTEM_GDBSTUB_RUNTIME=y

# Core dump to flash — preserves crash state for postmortem analysis
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Heap — poison every alloc, check on free, trace allocations
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_HEAP_TRACING_STANDALONE=y

# LVGL
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Debug-only features (enabled by debug preset, disabled by release preset)
CONFIG_ESP_DEBUG_TOUCH_OVERLAY=y